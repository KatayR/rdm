{
  "manifest_version": 3,
  "name": "RDM",
  "version": "0.3.0",
  "description": "Sends downloads and videos to RDM. Alt+click a link to download it with the browser instead.",
  "key": "",
  "permissions": [
    "downloads",
    "nativeMessaging",
    "cookies",
    "contextMenus",
    "storage",
    "webRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "types.js",
        "content.js",
        "video.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_origin_as_fallback": true
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "sniff.js"
      ],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true,
      "match_origin_as_fallback": true
    }
  ],
  "action": {
    "default_title": "RDM: capturing downloads (click to turn off)"
  }
}
